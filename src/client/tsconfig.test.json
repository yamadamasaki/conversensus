{
  /* 単体テスト用。bun test は transpile only で実行するので, ここで見ないと
     フェイクと本物のインタフェースの乖離が実行時まで分からない
     (tsconfig.e2e.json と同じ理由)。

     本体用の tsconfig.app.json と分けるのは, あちらが `tsc -b` で本番ビルドに
     使われるため — テストを本番ビルドの対象に入れてはならない */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    /* テストは bun のランタイム (bun:test) で動く */
    "types": ["bun"]
  },
  "include": ["src"],
  "exclude": []
}
