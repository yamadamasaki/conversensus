{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "types": ["bun"],
    "skipLibCheck": true,

    /* Bundler mode (client の tsconfig.app.json に合わせる) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  /* テストも型検査する。bun test は transpile only なので, ここで見ないと
     フェイクと本物のインタフェースの乖離が実行時まで分からない
     (tsconfig.e2e.json と同じ理由)。server は tsc でビルドしないので,
     本体用の設定と分けずにここへ含める */
  "include": ["src"]
}
