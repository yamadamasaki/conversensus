{
	"$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"src/**/*.ts",
			"src/**/*.tsx",
			"tests/**/*.ts",
			"scripts/**/*.ts",
			"playwright.config.ts",
			"playwright.shots.config.ts",
			"docs/introductory_guide_to_conversensus/shots/**/*.ts",
			"docs/.vitepress/config.mts",
			"docs/.vitepress/theme/**/*.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": [
				"src/shared/**",
				"src/client/**",
				"!src/client/src/main.tsx",
				"src/headless/**",
				"!src/headless/src/mcp.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@conversensus/request",
											"@conversensus/request/**",
											"**/modules/**"
										],
										"message": "core (shared・client・headless) は module を import しない。module を使うかは入口 (src/client/src/main.tsx・src/headless/src/mcp.ts) が決める (計画 node-actions-request-module.md §3.2・N4・B4)"
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
